<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      This is the one permission the security policy refuses in what this
      engine builds, and the one this application holds. Installing the
      package it has just built is what it is for; without this, the button
      that offers to do so cannot do anything at all. Android still asks the
      person once, per source, before any install proceeds. Nothing this
      engine produces is given the permission: the policy refuses it there,
      and a test holds it to that.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BuilderApplication"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/omni_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omni">

        <provider
            android:name=".PackageProvider"
            android:authorities="${applicationId}.packages"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".SentryService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".BuilderActivity"
            android:exported="true"
            android:label="@string/omni_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
