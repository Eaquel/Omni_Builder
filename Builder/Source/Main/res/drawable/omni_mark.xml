    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Artifact layer (top) -->
    <path
        android:fillColor="#6CB6FF"
        android:pathData="M54,26 L74,38 L54,50 L34,38 Z" />

    <!-- Plugin runtime layer (middle) -->
    <path
        android:fillColor="#4A90D9"
        android:pathData="M34,46 L54,58 L74,46 L74,52 L54,64 L34,52 Z" />

    <!-- Core layer (bottom) -->
    <path
        android:fillColor="#2F6DA8"
        android:pathData="M34,60 L54,72 L74,60 L74,66 L54,78 L34,66 Z" />
</vector>
